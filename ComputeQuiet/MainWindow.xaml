<Window x:Class="ComputeQuiet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComputeQuiet"
        Width="560" Height="720"
        MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI"
        FontSize="14"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Closing="OnClosing">
  <Window.Resources>
    <LinearGradientBrush x:Key="WindowWash" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#121416" Offset="0"/>
      <GradientStop Color="#1C2422" Offset="1"/>
    </LinearGradientBrush>
  </Window.Resources>

  <Grid Background="{StaticResource WindowWash}">
    <Ellipse Width="360" Height="280" HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="0,-80,-80,0" Opacity="0.18">
      <Ellipse.Fill>
        <SolidColorBrush Color="#3E8C6E"/>
      </Ellipse.Fill>
    </Ellipse>

    <DockPanel Margin="28">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
        <TextBlock Text="ComputeQuiet"
                   FontSize="32" FontWeight="SemiBold"
                   Foreground="{StaticResource FgBrush}"
                   TextWrapping="Wrap"/>
        <TextBlock Text="Park background work. Free the machine for play or local AI."
                   FontSize="14"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>
      </StackPanel>

      <Button x:Name="ToggleButton"
              DockPanel.Dock="Top"
              Style="{StaticResource ToggleButtonStyle}"
              Content="GO QUIET"
              Background="{StaticResource QuietGreenBrush}"
              Foreground="{StaticResource FgBrush}"
              HorizontalAlignment="Center"
              Margin="0,0,0,24"
              Click="OnToggleClick"/>

      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
        <CheckBox x:Name="AggressiveCheck"
                  Content="Aggressive — suspend all non-essential apps"/>
        <CheckBox x:Name="PowerPlanCheck"
                  Content="Switch to High Performance power plan while quiet"
                  Checked="OnPowerPlanChanged" Unchecked="OnPowerPlanChanged"/>
        <CheckBox x:Name="StartWithWindowsCheck"
                  Content="Start with Windows (tray)"
                  Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged"/>
        <CheckBox x:Name="MinimizeToTrayCheck"
                  Content="Close button minimizes to tray"
                  Checked="OnMinimizeToTrayChanged" Unchecked="OnMinimizeToTrayChanged"/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <TextBlock Text="Also keep running (comma-separated names)"
                   Foreground="{StaticResource DimBrush}"
                   Margin="0,0,0,6"/>
        <TextBox x:Name="KeepAliveBox"
                 Background="{StaticResource PanelBrush}"
                 Foreground="{StaticResource FgBrush}"
                 BorderBrush="#3A3C40"
                 BorderThickness="1"
                 Padding="10,8"
                 FontSize="14"
                 CaretBrush="{StaticResource FgBrush}"
                 Tag="e.g. Discord, chrome"/>
      </StackPanel>

      <TextBlock x:Name="StatusText"
                 DockPanel.Dock="Top"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource MutedBrush}"
                 Margin="0,0,0,12"/>

      <ListBox x:Name="LogList"
               Background="{StaticResource PanelBrush}"
               Foreground="{StaticResource MutedBrush}"
               BorderThickness="0"
               FontFamily="Consolas"
               FontSize="12"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
  </Grid>
</Window>
